      "no_speech_prob": 0.06697984039783478
    },
    {
      "start": 4.99,
      "end": 7.07,
      "text": "现在目前做过项目的小伙伴有多少",
      "avg_logprob": -0.23333922725671913,
      "no_speech_prob": 0.06697984039783478
    },
    {
      "start": 7.07,
      "end": 8.91,
      "text": "成功一个月的时间",
