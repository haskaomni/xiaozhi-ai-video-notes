      "no_speech_prob": 0.00039619128801859915
    },
    {
      "start": 53.51,
      "end": 55.39,
      "text": "我基于两个真实的这个案例",
      "avg_logprob": -0.16678782922880991,
      "no_speech_prob": 0.00039619128801859915
    },
    {
      "start": 55.39,
      "end": 56.43,
      "text": "就是过来说",
      "avg_logprob": -0.16678782922880991,
      "no_speech_prob": 0.00039619128801859915
    },
    {
      "start": 56.43,
      "end": 58.51,
      "text": "我现在员工大概有这么多",
      "avg_logprob": -0.16678782922880991,
      "no_speech_prob": 0.00039619128801859915
    },
    {
      "start": 58.51,
      "end": 60.67,
      "text": "然后公司大概有这么多",
      "avg_logprob": -0.16678782922880991,
      "no_speech_prob": 0.00039619128801859915
    },
    {
      "start": 60.67,
