    {
      "start": 45.56,
      "end": 49.44,
      "text": "考核方式和商業模式全都是舊時代的產物",
      "avg_logprob": -0.13110076080118943,
      "no_speech_prob": 0.009496569633483887
    },
    {
      "start": 49.44,
      "end": 51.24,
      "text": "結果特別喜歡一個比喻",
      "avg_logprob": -0.13110076080118943,
      "no_speech_prob": 0.009496569633483887
    },
    {
      "start": 51.24,
      "end": 53.36,
      "text": "一艘為遠洋打撈設計的船",
      "avg_logprob": -0.13110076080118943,
      "no_speech_prob": 0.009496569633483887
    },
    {
      "start": 53.36,
      "end": 55.72,
      "text": "把它改造成一個潛水艇的成本",
      "avg_logprob": -0.13110076080118943,
      "no_speech_prob": 0.009496569633483887
    },
    {
