      "no_speech_prob": 0.07079777121543884
    },
    {
      "start": 15.48,
      "end": 17.28,
      "text": "做成了一张图放在最后",
      "avg_logprob": -0.22195899859070778,
      "no_speech_prob": 0.07079777121543884
    },
    {
      "start": 17.28,
      "end": 21.04,
      "text": "中间这段我先把他的病一层一层挖出来给你看",
      "avg_logprob": -0.22195899859070778,
      "no_speech_prob": 0.07079777121543884
    },
    {
      "start": 21.04,
      "end": 22.4,
      "text": "大家完全可以对照一下",
      "avg_logprob": -0.22195899859070778,
      "no_speech_prob": 0.07079777121543884
    },
    {
      "start": 22.4,
      "end": 24.88,
      "text": "看你的公司目前病到第几层了",
