      "no_speech_prob": 0.07079777121543884
    },
    {
      "start": 24.88,
      "end": 25.72,
      "text": "先说清楚",
      "avg_logprob": -0.22195899859070778,
      "no_speech_prob": 0.07079777121543884
    },
    {
      "start": 25.72,
      "end": 28.24,
      "text": "这家公司的问题不是说生意不好",
