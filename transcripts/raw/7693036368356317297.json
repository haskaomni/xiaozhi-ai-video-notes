  "segments": [
    {
      "start": 0.0,
      "end": 2.88,
      "text": "国境这两天聊了一个赶速做电商的老板",
      "avg_logprob": -0.22195899859070778,
      "no_speech_prob": 0.07079777121543884
    },
    {
      "start": 2.88,
      "end": 4.0,
      "text": "他是做游戏类目的",
      "avg_logprob": -0.22195899859070778,
      "no_speech_prob": 0.07079777121543884
    },
    {
      "start": 4.0,
      "end": 6.4,
      "text": "一天订单有上千上万笔",
      "avg_logprob": -0.22195899859070778,
      "no_speech_prob": 0.07079777121543884
    },
    {
      "start": 6.4,
      "end": 8.08,
      "text": "我问他一年到底能算多少钱",
      "avg_logprob": -0.22195899859070778,
      "no_speech_prob": 0.07079777121543884
    },
    {
      "start": 8.08,
      "end": 8.96,
      "text": "就问他粘产值",
      "avg_logprob": -0.22195899859070778,
      "no_speech_prob": 0.07079777121543884
    },
    {
      "start": 8.96,
      "end": 10.4,
      "text": "他沉默了两三秒",
      "avg_logprob": -0.22195899859070778,
      "no_speech_prob": 0.07079777121543884
    },
    {
      "start": 10.4,
      "end": 10.92,
      "text": "说实话",
      "avg_logprob": -0.22195899859070778,
      "no_speech_prob": 0.07079777121543884
    },
    {
      "start": 10.92,
      "end": 12.04,
      "text": "他根本就算不清",
      "avg_logprob": -0.22195899859070778,
      "no_speech_prob": 0.07079777121543884
    },
    {
      "start": 12.04,
      "end": 13.72,
      "text": "今天我把这个病给大家说明",
      "avg_logprob": -0.22195899859070778,
      "no_speech_prob": 0.07079777121543884
    },
    {
      "start": 13.72,
      "end": 15.48,
      "text": "然后告诉大家怎么去治",
