      "no_speech_prob": 0.222069650888443
    },
    {
      "start": 23.12,
      "end": 25.04,
      "text": "原来的库存官员要干嘛",
      "avg_logprob": -0.2706412738138209,
      "no_speech_prob": 0.222069650888443
    },
    {
      "start": 25.04,
      "end": 26.4,
      "text": "每周你查两三次账",
