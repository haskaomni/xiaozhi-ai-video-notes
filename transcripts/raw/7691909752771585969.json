  "segments": [
    {
      "start": 0.0,
      "end": 1.28,
      "text": "今天我参加了一个饭局",
      "avg_logprob": -0.22117809153891899,
      "no_speech_prob": 0.17893151938915253
    },
    {
      "start": 1.28,
      "end": 2.96,
      "text": "一个做软件开发",
