      "no_speech_prob": 0.06929813325405121
    },
    {
      "start": 18.0,
      "end": 19.0,
      "text": "如何我給你做服務吧",
      "avg_logprob": -0.21020922793282404,
      "no_speech_prob": 0.06929813325405121
    },
    {
      "start": 19.0,
      "end": 20.0,
      "text": "這個東西給你交付完",
