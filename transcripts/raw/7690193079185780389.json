  "segments": [
    {
      "start": 0.0,
      "end": 3.52,
      "text": "FD火了四個月我發現一個特別反常識的現象",
      "avg_logprob": -0.19563850033573987,
      "no_speech_prob": 0.004514103755354881
    },
    {
      "start": 3.52,
      "end": 7.56,
      "text": "就是含轉型的那批人恰恰是最先調隊的",
      "avg_logprob": -0.19563850033573987,
      "no_speech_prob": 0.004514103755354881
    },
    {
      "start": 7.56,
      "end": 8.44,
      "text": "那為什麼呢",
      "avg_logprob": -0.19563850033573987,
      "no_speech_prob": 0.004514103755354881
    },
    {
      "start": 8.44,
      "end": 9.88,
      "text": "今天我就講一個系列",
      "avg_logprob": -0.19563850033573987,
      "no_speech_prob": 0.004514103755354881
    },
    {
      "start": 9.88,
      "end": 11.6,
      "text": "就是把這件事拆清楚",
      "avg_logprob": -0.19563850033573987,
      "no_speech_prob": 0.004514103755354881
    },
    {
      "start": 11.6,
      "end": 16.04,
      "text": "後面我會分別從拆技術公司、諮詢公司、專家、教授",
      "avg_logprob": -0.19563850033573987,
      "no_speech_prob": 0.004514103755354881
    },
    {
      "start": 16.04,
      "end": 19.6,
      "text": "最後講到FD到底誰能做誰能落地這件事",
      "avg_logprob": -0.19563850033573987,
      "no_speech_prob": 0.004514103755354881
    },
    {
      "start": 19.6,
      "end": 20.84,
      "text": "去跟大家講明白",
      "avg_logprob": -0.19563850033573987,
      "no_speech_prob": 0.004514103755354881
    },
    {
      "start": 20.84,
      "end": 22.12,
      "text": "那先說一個現象",
      "avg_logprob": -0.19563850033573987,
      "no_speech_prob": 0.004514103755354881
    },
    {
      "start": 22.12,
      "end": 24.44,
      "text": "AI來了之後所有人都湧進來了",
      "avg_logprob": -0.19563850033573987,
      "no_speech_prob": 0.004514103755354881
    },
    {
      "start": 24.44,
      "end": 26.64,
      "text": "當年的技術公司紛紛宣布說",
      "avg_logprob": -0.19563850033573987,
      "no_speech_prob": 0.004514103755354881
    },
    {
      "start": 26.64,
      "end": 27.76,
      "text": "全面轉型AI",
      "avg_logprob": -0.19563850033573987,
      "no_speech_prob": 0.004514103755354881
    },
    {
      "start": 27.76,
      "end": 30.84,
      "text": "諮詢公司推出五花八門的AI戰略諮詢",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 30.84,
      "end": 32.52,
      "text": "管理專家和這種教授",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 32.52,
      "end": 35.12,
      "text": "連也把客家裡的互聯網家變成人工智能家",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 35.12,
      "end": 35.92,
      "text": "然後呢",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 35.92,
      "end": 36.92,
      "text": "其實就沒有然後了",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 36.92,
      "end": 38.16,
      "text": "他們輸掉的不是能力",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 38.16,
      "end": 39.24,
      "text": "你注意這句話",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 39.24,
      "end": 42.68,
      "text": "他們輸掉的是他們賴以成功的能力本身",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 42.68,
      "end": 43.64,
      "text": "那為什麼這麼說呢",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 43.64,
      "end": 46.6,
      "text": "因為AI又不是一個可以封裝的標準化的產品",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 46.6,
      "end": 48.2,
      "text": "過去20年所有人的成功",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 48.2,
      "end": 49.96,
      "text": "都建立在統一的範圍上",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 49.96,
      "end": 52.92,
      "text": "把複雜的東西變成標準化的產品",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 52.92,
      "end": 53.76,
      "text": "定格高價",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 53.76,
      "end": 55.12,
      "text": "造銷售和渠道賣出去",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 55.12,
      "end": 56.72,
      "text": "這套邏輯在軟價時代",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 56.72,
      "end": 57.56,
      "text": "無網不利",
      "avg_logprob": -0.13352893180442307,
      "no_speech_prob": 0.09133575856685638
    },
    {
      "start": 57.56,
      "end": 59.68,
      "text": "但AI時代的本質是什麼",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 59.68,
      "end": 61.52,
      "text": "深入一家企業的業務流程",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 61.52,
      "end": 65.4,
      "text": "把知識經驗和決策流程全部重構一遍",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 65.4,
      "end": 66.84,
      "text": "這個不是賣盒子",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 66.84,
      "end": 67.76,
      "text": "這個是動手術",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 67.76,
      "end": 68.72,
      "text": "我簡單舉個例子",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 68.72,
      "end": 70.08,
      "text": "就以我的真事",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 70.08,
      "end": 72.16,
      "text": "我們服務過一個傳統製造業的企業",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 72.16,
      "end": 73.32,
      "text": "他們來找我的時候",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 73.32,
      "end": 74.12,
      "text": "需求特別小",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 74.12,
      "end": 76.12,
      "text": "CAD畫圖菜消耗人力",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 76.12,
      "end": 77.64,
      "text": "然後我們用AI去出土",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 77.64,
      "end": 80.68,
      "text": "直接剩掉了80%的畫圖工作和人力成本",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 80.68,
      "end": 82.4,
      "text": "但是真正坐進去之後才發現",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 82.4,
      "end": 83.92,
      "text": "圖紙後面連著布姆聽單",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 83.92,
      "end": 85.68,
      "text": "布姆聽單決定著庫存",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 85.68,
      "end": 87.12,
      "text": "庫存又決定著交付",
      "avg_logprob": -0.17080590520242248,
      "no_speech_prob": 0.0024519432336091995
    },
    {
      "start": 87.16,
      "end": 90.0,
      "text": "這一條連路給打通至少省的是幾千萬",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 90.0,
      "end": 91.4,
      "text": "因為他們是B2B的生意",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 91.4,
      "end": 93.0,
      "text": "你如果庫存管理不好",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 93.0,
      "end": 94.48,
      "text": "你後邊影響交付",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 94.48,
      "end": 95.36,
      "text": "這個信任",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 95.36,
      "end": 96.92,
      "text": "它就不是幾千萬的事了",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 96.92,
      "end": 99.24,
      "text": "所以你看這才是AI落地的真正樣子",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 99.24,
      "end": 100.6,
      "text": "它不是給你一個工具",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 100.6,
      "end": 103.88,
      "text": "是把你的業務流程重新去改一遍",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 103.88,
      "end": 105.16,
      "text": "所以那些問題就來了",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 105.16,
      "end": 106.84,
      "text": "那些賣罐盒子的人",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 106.84,
      "end": 108.64,
      "text": "怎麼去做得了手術",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 108.64,
      "end": 110.32,
      "text": "這個就是舊時代的贏家",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 110.32,
      "end": 112.84,
      "text": "做不了新時代的事的根本原因",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 112.84,
      "end": 114.44,
      "text": "這個系列我會一條一條拆解",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 114.44,
      "end": 116.32,
      "text": "你想知道我們到底怎麼判斷",
      "avg_logprob": -0.12591950034582486,
      "no_speech_prob": 0.006732819601893425
    },
    {
      "start": 116.36,
      "end": 118.08,
      "text": "一個AI項目到底能不能做",
      "avg_logprob": -0.4396442510187626,
      "no_speech_prob": 0.9234771728515625
    },
    {
      "start": 118.08,
      "end": 119.04,
      "text": "實情往落地",
      "avg_logprob": -0.4396442510187626,
      "no_speech_prob": 0.9234771728515625
    },
    {
      "start": 119.04,
      "end": 119.76,
      "text": "我告訴你",
      "avg_logprob": -0.4396442510187626,
      "no_speech_prob": 0.9234771728515625
    }
  ]
