      "no_speech_prob": 0.0991402268409729
    },
    {
      "start": 24.5,
      "end": 26.0,
      "text": "前段时间特别火的一个视频",
      "avg_logprob": -0.13967296401447155,
      "no_speech_prob": 0.0991402268409729
    },
    {
      "start": 26.0,
      "end": 29.0,
      "text": "老大的快乐生活非常明确的表现了",
      "avg_logprob": -0.13967296401447155,
      "no_speech_prob": 0.0991402268409729
    },
    {
      "start": 29.0,
      "end": 31.2,
      "text": "现在市面上的FD做的是什么事",
